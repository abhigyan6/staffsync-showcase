# Leave MONGODB_URI unset for the persistent embedded local-development database.
# Production requires a real MongoDB connection and a strong JWT secret.
# MONGODB_URI=mongodb://127.0.0.1:27017/staffsync
# JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=4000
APP_TIMEZONE=Asia/Kolkata
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4000,http://localhost:4000
COOKIE_SECURE=false
SEED_DEMO=true
