{
  "name": "staffsync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "nodemon --watch server --ext js,json --signal SIGTERM --delay 500ms server/server.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/server.js",
    "seed": "node server/seed-cli.js",
    "setup:hr": "node server/setup-hr.js",
    "format": "prettier --write client/src server vite.config.js",
    "format:check": "prettier --check client/src server vite.config.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@mui/material": "^7.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@reduxjs/toolkit": "^2.9.0",
    "axios": "^1.12.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.2.0",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "vite": "^7.1.0"
  }
}
